# --- Core -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite locally. Production: postgres://user:pass@host:5432/db
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex (e.g. Vercel preview URLs): ^https://eld-trip-planner.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# --- Mapping providers -------------------------------------------------
# osrm (free, no key) or openrouteservice (free key, truck profile)
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
# Comma-separated Overpass mirrors, raced for best-effort fuel-station lookup
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# OSM usage policies require an identifying User-Agent (use your repo URL or email).
# Placeholder domains such as example.com are blocked (HTTP 403).
HTTP_USER_AGENT=eld-trip-planner/1.0 (+https://github.com/your-username/eld-trip-planner)
GEOCODING_COUNTRY_CODES=us
ENABLE_FUEL_STATION_LOOKUP=True
ENABLE_REVERSE_GEOCODING=True
